# HomeKTV server deployment environment.
# Copy this file to deploy/docker/.env or deploy/source/.env and update values.

COMPOSE_PROJECT_NAME=home-ktv

# Public URLs reachable by phone and Android TV.
PUBLIC_BASE_URL=http://127.0.0.1:4000
ADMIN_BASE_URL=http://127.0.0.1:5174
CONTROLLER_BASE_URL=http://127.0.0.1:5176
TV_WEB_BASE_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://127.0.0.1:5176,http://127.0.0.1:5173

# Room.
TV_ROOM_SLUG=living-room

# Source deployment database. Docker uses DOCKER_DATABASE_URL below.
POSTGRES_DB=home_ktv
POSTGRES_USER=ktv
POSTGRES_PASSWORD=ktv
DATABASE_URL=postgres://ktv:ktv@127.0.0.1:5432/home_ktv
DOCKER_DATABASE_URL=postgres://ktv:ktv@postgres:5432/home_ktv

# Runtime media directories. Source uses MEDIA_ROOT; Docker mounts KTV_MEDIA_HOST_PATH to DOCKER_MEDIA_ROOT.
MEDIA_ROOT=./runtime/media
DOCKER_MEDIA_ROOT=/data/home-ktv-media
KTV_MEDIA_HOST_PATH=../../runtime/media

# Real NAS library mapping.
# KTV_NAS_HOST_PATH is the server host mount path used by Docker.
# MEDIA_PATH_MAPPINGS is used by source deployment.
# DOCKER_MEDIA_PATH_MAPPINGS is used inside Docker containers.
KTV_NAS_HOST_PATH=../../runtime/nas/KTV歌曲
MEDIA_PATH_MAPPINGS=/mnt/nas/KTV歌曲=/mnt/nas/KTV歌曲
DOCKER_MEDIA_PATH_MAPPINGS=/mnt/nas/KTV歌曲=/nas/KTV歌曲

# Optional online song source (ige8 / 爱歌吧).
# ONLINE_PROVIDER_IDS=igeba enables it; online songs are always cached into
# MEDIA_ROOT/online-cache/igeba before playback.
ONLINE_PROVIDER_IDS=
ONLINE_PROVIDER_KILL_SWITCH_IDS=
IGEBA_ENABLED=false
IGEBA_BASE_URL=http://app.ige8.net
IGEBA_UID=0
IGEBA_MIN_INTERVAL_MS=1000
IGEBA_REQUEST_TIMEOUT_MS=20000
IGEBA_RESOLVE_ATTEMPTS=30
IGEBA_CACHE_DIR=
IGEBA_CONCURRENCY=1

# Optional OpenAI-compatible local LLM for style tag fallback.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional internal NeteaseCloudMusicApi service for cover fetching.
NETEASE_CLOUD_MUSIC_API_BASE_URL=http://127.0.0.1:4300

# Ports.
API_PORT=4000
ADMIN_PORT=5174
CONTROLLER_PORT=5176
TV_WEB_PORT=5173
