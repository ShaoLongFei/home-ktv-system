{
  "name": "@home-ktv/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "migrate": "node scripts/apply-migrations.mjs",
    "index:ktv": "tsx src/scripts/ktv-full-index.ts",
    "import:songs": "tsx src/scripts/ktv-song-import.ts",
    "probe:ktv-index": "tsx src/scripts/ktv-index-probe.ts",
    "clean:variety-show-metadata": "tsx src/scripts/clean-variety-show-metadata.ts",
    "repair:ktv-song-metadata": "tsx src/scripts/repair-ktv-song-metadata.ts",
    "covers:songs": "python3 ../../scripts/fetch_song_covers.py fetch",
    "covers:coverage": "python3 ../../scripts/fetch_song_covers.py coverage",
    "covers:status": "python3 ../../scripts/fetch_song_covers.py status",
    "sample:ktv-index": "tsx src/scripts/ktv-sample-index.ts",
    "test": "vitest run",
    "start": "node dist/server.js",
    "igeba:load": "tsx src/scripts/igeba-library-load.ts"
  },
  "dependencies": {
    "@fastify/websocket": "11.2.0",
    "@home-ktv/domain": "workspace:*",
    "@home-ktv/player-contracts": "workspace:*",
    "@home-ktv/protocol": "workspace:*",
    "@home-ktv/session-engine": "workspace:*",
    "chokidar": "5.0.0",
    "fastify": "5.8.5",
    "opencc-js": "1.3.0",
    "pg": "^8.20.0",
    "pinyin-pro": "3.28.1"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/pg": "^8.20.0",
    "tsx": "4.21.0",
    "vitest": "^4.1.5"
  }
}
